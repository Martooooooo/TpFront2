---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Calendario</title>
  </head>
  <body>
    <header class="topbar">
      <div>
        <div class="topbar-kicker">Calendario</div>
        <div class="topbar-title">Organizá tus eventos</div>
      </div>
      <div class="auth-actions topbar-actions">
        <button id="register-btn" class="ghost-btn" type="button">Registrarse</button>
        <button id="login-btn" class="login-btn" type="button">Iniciar sesión</button>
      </div>
    </header>

    <button id="drawer-toggle-btn" class="drawer-fab hidden" type="button" aria-expanded="false" aria-controls="upcoming-drawer">
      Próximos eventos
    </button>

    <div class="drawer-overlay hidden" id="drawer-overlay"></div>

    <aside class="upcoming-drawer hidden" id="upcoming-drawer" aria-label="Próximos eventos">
      <div class="drawer-head">
        <div>
          <div class="drawer-title">Próximos eventos</div>
          <div class="drawer-subtitle" id="drawer-count">0 eventos</div>
        </div>
        <button id="close-drawer-btn" class="drawer-close" type="button" aria-label="Cerrar panel">×</button>
      </div>
      <div class="drawer-body" id="drawer-list"></div>
    </aside>

    <div class="app">
      <div class="cal-side">
        <div class="nav">
          <button id="prev">&#8592;</button>
          <span id="mlabel"></span>
          <button id="next">&#8594;</button>
        </div>
        <div class="weekdays">
          <div class="wday">Dom</div><div class="wday">Lun</div><div class="wday">Mar</div>
          <div class="wday">Mié</div><div class="wday">Jue</div><div class="wday">Vie</div>
          <div class="wday">Sáb</div>
        </div>
        <div class="calendar" id="cal"></div>
      </div>

      <div class="panel">
        <div class="panel-head">
          <div>
            <div class="panel-title">Nuevo evento</div>
            <div class="sel-label" id="user-status">Iniciá sesión para habilitar el calendario</div>
          </div>
        </div>

        <div class="sel-label" id="sel-label">Hacé clic en un día para seleccionarlo</div>

        <div class="field">
          <label>Nombre</label>
          <input type="text" id="f-name" placeholder="Nombre del evento" />
        </div>
        <div class="field">
          <label>Categoría</label>
          <select id="f-cat">
            <option value="1">Trabajo</option>
            <option value="2">Escuela</option>
            <option value="3">Personal</option>
            <option value="4">Entretenimiento</option>
          </select>
        </div>
        <div class="field">
          <label>Color</label>
          <div class="colors" id="color-picker"></div>
        </div>
        <div class="field">
          <label>Horario</label>
          <div class="time-row">
            <input type="time" id="f-start" />
            <input type="time" id="f-end" />
          </div>
        </div>
        <div class="field">
          <label>Descripción</label>
          <textarea id="f-desc" placeholder="Detalles del evento..."></textarea>
        </div>
        <button id="add-btn">+ Agregar evento</button>
        <div class="events-list" id="events-list"></div>
      </div>
    </div>

    <div class="modal-backdrop hidden" id="login-modal">
      <div class="modal">
        <div class="modal-title" id="auth-title">Cuenta</div>
        <div class="modal-text" id="auth-text">Registrate si no tenés cuenta o iniciá sesión si ya la creaste.</div>
        <div class="field">
          <label>Usuario</label>
          <input type="text" id="login-name" placeholder="Tu nombre" />
        </div>
        <div class="field">
          <label>Contraseña</label>
          <input type="password" id="login-password" placeholder="Tu contraseña" />
        </div>
        <div class="modal-status" id="login-status"></div>
        <div class="modal-actions">
          <button id="submit-register-btn" type="button" class="secondary-btn">Registrarme</button>
          <button id="close-login-btn" type="button" class="secondary-btn">Cancelar</button>
          <button id="submit-login-btn" type="button" class="primary-btn">Entrar</button>
        </div>
      </div>
    </div>
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: system-ui, sans-serif;
    background: #f5f5f3;
    min-height: 100vh;
    padding: 2rem 1rem;
  }

  .app {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 20px;
    max-width: 900px;
    margin: 0 auto;
    align-items: start;
  }

  .topbar {
    max-width: 900px;
    margin: 0 auto 1rem;
    padding: .9rem 1rem;
    border: 1px solid #e5e5e3;
    border-radius: 16px;
    background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
  }

  .topbar-kicker {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: .12em;
    color: #6b7280;
    font-weight: 800;
  }

  .topbar-title {
    font-size: 18px;
    font-weight: 800;
    color: #0f172a;
    margin-top: 2px;
  }

  .topbar-actions {
    flex-wrap: nowrap;
  }

  /* — nav — */
  .nav { display: flex; align-items: center; gap: 8px; margin-bottom: 1rem; }
  .nav button {
    background: none; border: 1px solid #ccc; border-radius: 8px;
    padding: 5px 14px; font-size: 13px; cursor: pointer; transition: background .15s;
  }
  .nav button:hover { background: #e9e9e7; }
  .nav span { font-size: 15px; font-weight: 500; flex: 1; text-align: center; }

  /* — weekdays — */
  .weekdays { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; margin-bottom: 4px; }
  .wday { text-align: center; font-size: 10px; font-weight: 600; color: #888; text-transform: uppercase; letter-spacing: .05em; padding: 3px 0; }

  /* — calendar grid — */
  .calendar { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; }
  .day {
    background: #fff; border: 1px solid #e5e5e3; border-radius: 8px;
    padding: 6px 5px; min-height: 58px; cursor: pointer;
    display: flex; flex-direction: column; gap: 2px;
    transition: border-color .15s, background .15s, transform .1s;
  }
  .day:hover { border-color: #aaa; background: #f9f9f7; transform: translateY(-1px); }
  .day.empty { background: transparent; border-color: transparent; cursor: default; pointer-events: none; }
  .day.selected { outline: 2px solid #185FA5; outline-offset: -1px; }
  .day.today .dnum {
    background: #3B6D11; color: #EAF3DE;
    border-radius: 50%; width: 20px; height: 20px;
    display: flex; align-items: center; justify-content: center; font-size: 11px;
  }
  .dnum { font-size: 12px; font-weight: 500; }

  /* — event pills in calendar — */
  .epill {
    font-size: 9px; border-radius: 3px; padding: 1px 4px;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    color: #fff; font-weight: 500;
  }

  /* — panel — */
  .panel {
    background: #fff; border: 1px solid #e5e5e3; border-radius: 12px;
    padding: 1rem; position: sticky; top: 1.5rem;
  }

  .drawer-fab {
    position: fixed;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    z-index: 44;
    border: 1px solid #c7d8ea;
    border-left: 0;
    border-radius: 0 14px 14px 0;
    background: #185FA5;
    color: #fff;
    padding: 12px 14px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .01em;
    box-shadow: 0 12px 24px rgba(24, 95, 165, .22);
    cursor: pointer;
  }

  .drawer-fab.hidden,
  .upcoming-drawer.hidden {
    display: none;
  }

  .drawer-overlay {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, .28);
    z-index: 45;
  }

  .upcoming-drawer {
    position: fixed;
    top: 0;
    left: 0;
    width: min(360px, 88vw);
    height: 100vh;
    background: #fff;
    border-right: 1px solid #e5e7eb;
    box-shadow: 16px 0 40px rgba(15, 23, 42, .15);
    z-index: 46;
    transform: translateX(-102%);
    transition: transform .2s ease;
    display: flex;
    flex-direction: column;
  }

  .upcoming-drawer.open {
    transform: translateX(0);
  }

  .drawer-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    padding: 1rem 1rem .75rem;
    border-bottom: 1px solid #eef2f7;
    background: linear-gradient(180deg, #f8fbff 0%, #ffffff 100%);
  }

  .drawer-title {
    font-size: 16px;
    font-weight: 800;
    color: #0f172a;
  }

  .drawer-subtitle {
    margin-top: 3px;
    font-size: 12px;
    color: #64748b;
  }

  .drawer-close {
    width: 32px;
    height: 32px;
    border-radius: 10px;
    border: 1px solid #dbe5f0;
    background: #fff;
    color: #334155;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
  }

  .drawer-body {
    padding: .9rem;
    overflow: auto;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .drawer-empty {
    padding: 1rem;
    border-radius: 14px;
    background: #f8fafc;
    border: 1px dashed #d8e2ee;
    color: #64748b;
    font-size: 13px;
    line-height: 1.4;
  }

  .drawer-event {
    border-radius: 14px;
    border: 1px solid #e5ecf5;
    padding: .85rem .9rem;
    background: #fff;
    box-shadow: 0 8px 20px rgba(15, 23, 42, .04);
  }

  .drawer-event-top {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    align-items: flex-start;
  }

  .drawer-event-name {
    font-size: 14px;
    font-weight: 700;
    color: #0f172a;
  }

  .drawer-event-date {
    font-size: 12px;
    color: #334155;
    margin-top: 3px;
  }

  .drawer-event-time {
    font-size: 12px;
    font-weight: 700;
    color: #185FA5;
    white-space: nowrap;
  }

  .drawer-event-desc {
    margin-top: .5rem;
    font-size: 12px;
    color: #64748b;
    line-height: 1.45;
  }

  .drawer-event-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: .6rem;
    padding: .28rem .55rem;
    border-radius: 999px;
    background: #f8fbff;
    color: #334155;
    font-size: 11px;
    font-weight: 700;
  }

  .drawer-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex: 0 0 auto;
  }
  .panel-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: .75rem;
  }
  .panel-title { font-size: 14px; font-weight: 500; margin-bottom: .2rem; }
  .sel-label {
    font-size: 11px; color: #666; margin-bottom: .6rem;
    padding: .35rem .5rem; background: #f5f5f3; border-radius: 6px;
  }
  .login-btn {
    background: #111827;
    color: #fff;
    border: 1px solid #111827;
    border-radius: 10px;
    padding: 8px 12px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }

  .auth-actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .ghost-btn {
    background: #fff;
    color: #185FA5;
    border: 1px solid #cfe0f3;
    border-radius: 10px;
    padding: 8px 12px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }

  /* — form fields — */
  .field { margin-bottom: .6rem; }
  .field label {
    display: block; font-size: 10px; font-weight: 600; color: #888;
    text-transform: uppercase; letter-spacing: .04em; margin-bottom: 3px;
  }
  .field input, .field select, .field textarea {
    width: 100%; border: 1px solid #ddd; border-radius: 8px;
    padding: 7px 9px; font-size: 13px; background: #fafaf8;
    outline: none; font-family: inherit; transition: border-color .15s;
  }
  .field input:focus, .field select:focus, .field textarea:focus {
    border-color: #888; background: #fff;
  }
  .field textarea { resize: vertical; min-height: 60px; line-height: 1.4; }
  .time-row { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }

  /* — color swatches — */
  .colors { display: flex; gap: 5px; flex-wrap: wrap; margin-top: 3px; }
  .cswatch {
    width: 22px; height: 22px; border-radius: 50%; cursor: pointer;
    border: 2px solid transparent; transition: transform .1s;
  }
  .cswatch:hover { transform: scale(1.15); }
  .cswatch.sel { border-color: #333; }

  /* — add button — */
  #add-btn {
    width: 100%; margin-top: .5rem; background: #dbeafe; color: #1e40af;
    border: 1px solid #bfdbfe; border-radius: 8px; padding: 8px;
    font-size: 13px; font-weight: 500; cursor: pointer; transition: opacity .15s;
  }
  #add-btn:hover { opacity: .85; }

  #add-btn:disabled {
    opacity: .55;
    cursor: not-allowed;
  }

  .field input:disabled,
  .field select:disabled,
  .field textarea:disabled {
    opacity: .6;
    cursor: not-allowed;
  }

  /* — events list in panel — */
  .events-list {
    margin-top: .75rem; border-top: 1px solid #eee; padding-top: .75rem;
    display: flex; flex-direction: column; gap: 6px;
    max-height: 200px; overflow-y: auto;
  }
  .ecard { border-radius: 8px; padding: 6px 8px; position: relative; }
  .ecard-name { font-size: 12px; font-weight: 500; color: #fff; }
  .ecard-meta { font-size: 10px; color: rgba(255,255,255,.8); margin-top: 2px; }
  .ecard-del {
    position: absolute; top: 4px; right: 6px;
    background: none; border: none; color: rgba(255,255,255,.7);
    cursor: pointer; font-size: 14px; line-height: 1; padding: 0;
  }
  .ecard-del:hover { color: #fff; }
  .no-events { font-size: 12px; color: #888; text-align: center; padding: .5rem 0; }

  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(17, 24, 39, 0.35);
    display: grid;
    place-items: center;
    padding: 1rem;
    z-index: 50;
  }

  .hidden { display: none; }

  .modal {
    width: min(100%, 360px);
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    padding: 1rem;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.14);
  }

  .modal-title {
    font-size: 16px;
    font-weight: 700;
    margin-bottom: .25rem;
  }

  .modal-text {
    font-size: 12px;
    color: #6b7280;
    margin-bottom: .8rem;
  }

  .modal-status {
    min-height: 16px;
    font-size: 12px;
    color: #b91c1c;
    margin-top: -.15rem;
    margin-bottom: .5rem;
  }

  .modal-actions {
    display: flex;
    gap: 8px;
    justify-content: flex-end;
    margin-top: .75rem;
  }

  .primary-btn,
  .secondary-btn {
    border-radius: 10px;
    padding: 8px 12px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }

  .primary-btn {
    background: #185FA5;
    color: #fff;
    border: 1px solid #185FA5;
  }

  .secondary-btn {
    background: #f3f4f6;
    color: #111827;
    border: 1px solid #d1d5db;
  }

  @media (max-width: 640px) {
    .topbar {
      flex-direction: column;
      align-items: flex-start;
    }

    .app { grid-template-columns: 1fr; }
    .panel { position: static; }
    .drawer-fab {
      top: auto;
      bottom: 16px;
      transform: none;
      border-radius: 0 14px 14px 0;
    }
  }
</style>

<script>
  import '../scripts/calendar';
</script>