<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Calendario</title>
  </head>
  <body>
    <main class="layout">
      <section class="login-card" id="login-panel">
        <h1>Ingresar</h1>
        <p class="login-sub">Accede para gestionar tus tareas del calendario.</p>

        <form id="login-form" class="login-form" autocomplete="off">
          <label>
            Usuario
            <input type="text" id="username" placeholder="Ej: admin" required />
          </label>

          <label>
            Clave
            <input type="password" id="password" placeholder="Tu clave" required />
          </label>

          <p class="login-error" id="login-error" aria-live="polite"></p>
          <button type="submit" class="login-btn">Entrar</button>
        </form>

        <p class="login-hint">Demo: usuario <strong>admin</strong> y clave <strong>1234</strong>.</p>
      </section>

      <section class="wrapper hidden" id="calendar-app">
        <div class="topbar">
          <span id="welcome-user"></span>
          <button id="logout">Cerrar sesion</button>
        </div>

        <div class="nav">
          <button id="prev">&#8592;</button>
          <span id="month-label"></span>
          <button id="next">&#8594;</button>
        </div>
        <div class="weekdays">
          <div class="weekday">Dom</div><div class="weekday">Lun</div><div class="weekday">Mar</div>
          <div class="weekday">Mie</div><div class="weekday">Jue</div><div class="weekday">Vie</div>
          <div class="weekday">Sab</div>
        </div>
        <div class="calendar" id="calendar"></div>
      </section>
    </main>

    <div class="modal-bg" id="modal">
      <div class="modal">
        <h2 id="modal-title"></h2>
        <div class="tasks-list" id="tasks-list"></div>
        <input type="text" id="task-input" placeholder="Nueva tarea..." />
        <div class="modal-actions">
          <button id="cancel-btn">Cancelar</button>
          <button id="save-btn">Agregar</button>
      </div>
      </div>
    </div>
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: system-ui, sans-serif;
    background: #f5f5f3;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 2rem 1rem;
  }

  .layout {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .hidden { display: none !important; }

  .login-card {
    width: 100%;
    max-width: 380px;
    background: #ffffff;
    border: 1px solid #e2e2df;
    border-radius: 14px;
    padding: 1.5rem;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.06);
  }

  .login-card h1 {
    font-size: 1.35rem;
    margin-bottom: 0.35rem;
  }

  .login-sub {
    color: #555;
    margin-bottom: 1.1rem;
    font-size: 0.95rem;
  }

  .login-form {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .login-form label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.9rem;
    color: #333;
  }

  .login-form input {
    border: 1px solid #d9d9d6;
    border-radius: 8px;
    padding: 10px;
    font-size: 0.95rem;
    outline: none;
  }

  .login-form input:focus {
    border-color: #3b6d11;
    box-shadow: 0 0 0 2px rgba(59, 109, 17, 0.14);
  }

  .login-btn {
    border: none;
    background: #3b6d11;
    color: #fff;
    border-radius: 8px;
    padding: 10px 12px;
    cursor: pointer;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .login-error {
    min-height: 1rem;
    font-size: 0.86rem;
    color: #a22;
  }

  .login-hint {
    margin-top: 1rem;
    font-size: 0.85rem;
    color: #666;
  }

  .wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 560px;
  }

  .topbar {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    gap: 1rem;
  }

  #welcome-user {
    font-size: 0.9rem;
    color: #555;
  }

  #logout {
    border: 1px solid #d8d8d6;
    background: #fff;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 0.82rem;
    cursor: pointer;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .nav button {
    background: none;
    border: 1px solid #ccc;
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 14px;
    cursor: pointer;
    transition: background 0.15s;
  }
  .nav button:hover { background: #e9e9e7; }
  .nav span {
    font-size: 16px;
    font-weight: 500;
    min-width: 180px;
    text-align: center;
  }

  .weekdays {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 6px;
    width: 100%;
    margin-bottom: 6px;
  }
  .weekday {
    text-align: center;
    font-size: 11px;
    font-weight: 600;
    color: #888;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 0;
  }

  .calendar {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 6px;
    width: 100%;
  }

  .day {
    background: #fff;
    border: 1px solid #e5e5e3;
    border-radius: 8px;
    padding: 8px;
    min-height: 64px;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s, transform 0.1s;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .day:hover {
    border-color: #aaa;
    background: #f9f9f7;
    transform: translateY(-2px);
  }
  .day.empty {
    background: transparent;
    border-color: transparent;
    cursor: default;
    pointer-events: none;
  }
  .day.today .day-num {
    background: #3B6D11;
    color: #EAF3DE;
    border-radius: 50%;
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
  }
  .day-num {
    font-size: 13px;
    font-weight: 500;
  }
  .task-pill {
    font-size: 10px;
    background: #dbeafe;
    color: #1e40af;
    border-radius: 4px;
    padding: 2px 5px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .modal-bg {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.35);
    justify-content: center;
    align-items: center;
    z-index: 100;
  }
  .modal-bg.open { display: flex; }
  .modal {
    background: #fff;
    border-radius: 12px;
    padding: 1.5rem;
    width: 300px;
    max-width: 90vw;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .modal h2 { font-size: 16px; font-weight: 500; }
  .tasks-list { max-height: 100px; overflow-y: auto; }
  .task-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    padding: 4px 0;
    border-bottom: 1px solid #eee;
  }
  .task-item button {
    background: none;
    border: none;
    color: #aaa;
    cursor: pointer;
    font-size: 14px;
  }
  .modal input {
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 8px 10px;
    font-size: 14px;
    width: 100%;
    outline: none;
  }
  .modal input:focus { border-color: #888; }
  .modal-actions {
    display: flex;
    gap: 8px;
    justify-content: flex-end;
  }
  .modal-actions button {
    border: 1px solid #ddd;
    background: none;
    border-radius: 8px;
    padding: 6px 16px;
    font-size: 13px;
    cursor: pointer;
    transition: background 0.15s;
  }
  .modal-actions button:hover { background: #f0f0ee; }
  #save-btn {
    background: #dbeafe;
    color: #1e40af;
    border-color: #bfdbfe;
  }
</style>

<script>
  const AUTH_KEY = 'calendar_user';
  const VALID_USER = 'admin';
  const VALID_PASS = '1234';

  const loginPanel = document.getElementById('login-panel') as HTMLElement;
  const calendarApp = document.getElementById('calendar-app') as HTMLElement;
  const loginForm = document.getElementById('login-form') as HTMLFormElement;
  const loginError = document.getElementById('login-error') as HTMLElement;
  const userInput = document.getElementById('username') as HTMLInputElement;
  const passInput = document.getElementById('password') as HTMLInputElement;
  const welcomeUser = document.getElementById('welcome-user') as HTMLElement;
  const logoutBtn = document.getElementById('logout') as HTMLButtonElement;

  function getLoggedUser() {
    return localStorage.getItem(AUTH_KEY);
  }

  function showLogin() {
    loginPanel.classList.remove('hidden');
    calendarApp.classList.add('hidden');
    loginError.textContent = '';
  }

  function showCalendar(username: string) {
    loginPanel.classList.add('hidden');
    calendarApp.classList.remove('hidden');
    welcomeUser.textContent = `Sesion iniciada: ${username}`;
    render();
  }

  loginForm.addEventListener('submit', e => {
    e.preventDefault();
    const user = userInput.value.trim();
    const pass = passInput.value;

    if (user === VALID_USER && pass === VALID_PASS) {
      localStorage.setItem(AUTH_KEY, user);
      passInput.value = '';
      showCalendar(user);
      return;
    }

    loginError.textContent = 'Usuario o clave incorrectos.';
  });

  logoutBtn.addEventListener('click', () => {
    localStorage.removeItem(AUTH_KEY);
    showLogin();
  });

  const MONTHS = ['Enero','Febrero','Marzo','Abril','Mayo','Junio',
    'Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];

  let events: Record<string, string[]> = {};
  const today = new Date();
  let viewYear = today.getFullYear();
  let viewMonth = today.getMonth();
  let selectedKey: string | null = null;

  const calEl = document.getElementById('calendar') as HTMLElement;
  const modalEl = document.getElementById('modal') as HTMLElement;
  const taskInput = document.getElementById('task-input') as HTMLInputElement;

  function getKey(y: number, m: number, d: number) {
    return `${y}-${m}-${d}`;
  }

  function render() {
    if (!calEl) return;
    document.getElementById('month-label')!.textContent =
      `${MONTHS[viewMonth]} ${viewYear}`;
    calEl.innerHTML = '';

    const firstDay = new Date(viewYear, viewMonth, 1).getDay();
    const daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();

    for (let i = 0; i < firstDay; i++) {
      const empty = document.createElement('div');
      empty.className = 'day empty';
      calEl.appendChild(empty);
    }

    for (let d = 1; d <= daysInMonth; d++) {
      const div = document.createElement('div');
      div.className = 'day';
      const isToday = d === today.getDate()
        && viewMonth === today.getMonth()
        && viewYear === today.getFullYear();
      if (isToday) div.classList.add('today');

      const numEl = document.createElement('div');
      numEl.className = 'day-num';
      numEl.textContent = String(d);
      div.appendChild(numEl);

      const key = getKey(viewYear, viewMonth, d);
      (events[key] ?? []).slice(0, 2).forEach(t => {
        const pill = document.createElement('div');
        pill.className = 'task-pill';
        pill.textContent = t;
        div.appendChild(pill);
      });
      if ((events[key] ?? []).length > 2) {
        const more = document.createElement('div');
        more.style.cssText = 'font-size:10px;color:#888;';
        more.textContent = `+${events[key].length - 2} más`;
        div.appendChild(more);
      }

      div.addEventListener('click', () => openModal(viewYear, viewMonth, d));
      calEl.appendChild(div);
    }
  }

  function openModal(y: number, m: number, d: number) {
    selectedKey = getKey(y, m, d);
    document.getElementById('modal-title')!.textContent =
      `${d} de ${MONTHS[m]} ${y}`;
    taskInput.value = '';
    renderTasksList();
    modalEl.classList.add('open');
    setTimeout(() => taskInput.focus(), 50);
  }

  function renderTasksList() {
    const list = document.getElementById('tasks-list')!;
    list.innerHTML = '';
    (events[selectedKey!] ?? []).forEach((t, i) => {
      const item = document.createElement('div');
      item.className = 'task-item';
      item.innerHTML = `<span>${t}</span><button data-i="${i}">✕</button>`;
      item.querySelector('button')!.addEventListener('click', () => {
        events[selectedKey!].splice(i, 1);
        renderTasksList();
        render();
        modalEl.classList.add('open');
      });
      list.appendChild(item);
    });
  }

  document.getElementById('save-btn')!.addEventListener('click', () => {
    const val = taskInput.value.trim();
    if (!val || !selectedKey) return;
    if (!events[selectedKey]) events[selectedKey] = [];
    events[selectedKey].push(val);
    taskInput.value = '';
    renderTasksList();
    render();
    modalEl.classList.add('open');
  });

  taskInput.addEventListener('keydown', e => {
    if (e.key === 'Enter') document.getElementById('save-btn')!.click();
  });

  document.getElementById('cancel-btn')!.addEventListener('click', () => {
    modalEl.classList.remove('open');
    selectedKey = null;
  });

  modalEl.addEventListener('click', e => {
    if (e.target === modalEl) modalEl.classList.remove('open');
  });

  document.getElementById('prev')!.addEventListener('click', () => {
    viewMonth--;
    if (viewMonth < 0) { viewMonth = 11; viewYear--; }
    render();
  });
  document.getElementById('next')!.addEventListener('click', () => {
    viewMonth++;
    if (viewMonth > 11) { viewMonth = 0; viewYear++; }
    render();
  });

  const loggedUser = getLoggedUser();
  if (loggedUser) {
    showCalendar(loggedUser);
  } else {
    showLogin();
  }
</script>