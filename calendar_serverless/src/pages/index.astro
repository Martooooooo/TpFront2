<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Calendario</title>
  </head>
  <body>
    <div class="app">
      <div class="cal-side">
        <div class="nav">
          <button id="prev">&#8592;</button>
          <span id="mlabel"></span>
          <button id="next">&#8594;</button>
        </div>
        <div class="weekdays">
          <div class="wday">Dom</div><div class="wday">Lun</div><div class="wday">Mar</div>
          <div class="wday">Mié</div><div class="wday">Jue</div><div class="wday">Vie</div>
          <div class="wday">Sáb</div>
        </div>
        <div class="calendar" id="cal"></div>
      </div>

      <div class="panel">
        <div class="panel-title">Nuevo evento</div>
        <div class="sel-label" id="sel-label">Hacé clic en un día para seleccionarlo</div>

        <div class="field">
          <label>Nombre</label>
          <input type="text" id="f-name" placeholder="Nombre del evento" />
        </div>
        <div class="field">
          <label>Categoría</label>
          <select id="f-cat">
            <option value="trabajo">Trabajo</option>
            <option value="escuela">Escuela</option>
            <option value="personal">Personal</option>
            <option value="entretenimiento">Entretenimiento</option>
          </select>
        </div>
        <div class="field">
          <label>Color</label>
          <div class="colors" id="color-picker"></div>
        </div>
        <div class="field">
          <label>Horario</label>
          <div class="time-row">
            <input type="time" id="f-start" />
            <input type="time" id="f-end" />
          </div>
        </div>
        <div class="field">
          <label>Descripción</label>
          <textarea id="f-desc" placeholder="Detalles del evento..."></textarea>
        </div>
        <button id="add-btn">+ Agregar evento</button>
        <div class="events-list" id="events-list"></div>
      </div>
    </div>
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: system-ui, sans-serif;
    background: #f5f5f3;
    min-height: 100vh;
    padding: 2rem 1rem;
  }

  .app {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 20px;
    max-width: 900px;
    margin: 0 auto;
    align-items: start;
  }

  /* — nav — */
  .nav { display: flex; align-items: center; gap: 8px; margin-bottom: 1rem; }
  .nav button {
    background: none; border: 1px solid #ccc; border-radius: 8px;
    padding: 5px 14px; font-size: 13px; cursor: pointer; transition: background .15s;
  }
  .nav button:hover { background: #e9e9e7; }
  .nav span { font-size: 15px; font-weight: 500; flex: 1; text-align: center; }

  /* — weekdays — */
  .weekdays { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; margin-bottom: 4px; }
  .wday { text-align: center; font-size: 10px; font-weight: 600; color: #888; text-transform: uppercase; letter-spacing: .05em; padding: 3px 0; }

  /* — calendar grid — */
  .calendar { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; }
  .day {
    background: #fff; border: 1px solid #e5e5e3; border-radius: 8px;
    padding: 6px 5px; min-height: 58px; cursor: pointer;
    display: flex; flex-direction: column; gap: 2px;
    transition: border-color .15s, background .15s, transform .1s;
  }
  .day:hover { border-color: #aaa; background: #f9f9f7; transform: translateY(-1px); }
  .day.empty { background: transparent; border-color: transparent; cursor: default; pointer-events: none; }
  .day.selected { outline: 2px solid #185FA5; outline-offset: -1px; }
  .day.today .dnum {
    background: #3B6D11; color: #EAF3DE;
    border-radius: 50%; width: 20px; height: 20px;
    display: flex; align-items: center; justify-content: center; font-size: 11px;
  }
  .dnum { font-size: 12px; font-weight: 500; }

  /* — event pills in calendar — */
  .epill {
    font-size: 9px; border-radius: 3px; padding: 1px 4px;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    color: #fff; font-weight: 500;
  }

  /* — panel — */
  .panel {
    background: #fff; border: 1px solid #e5e5e3; border-radius: 12px;
    padding: 1rem; position: sticky; top: 1.5rem;
  }
  .panel-title { font-size: 14px; font-weight: 500; margin-bottom: .75rem; }
  .sel-label {
    font-size: 11px; color: #666; margin-bottom: .6rem;
    padding: .35rem .5rem; background: #f5f5f3; border-radius: 6px;
  }

  /* — form fields — */
  .field { margin-bottom: .6rem; }
  .field label {
    display: block; font-size: 10px; font-weight: 600; color: #888;
    text-transform: uppercase; letter-spacing: .04em; margin-bottom: 3px;
  }
  .field input, .field select, .field textarea {
    width: 100%; border: 1px solid #ddd; border-radius: 8px;
    padding: 7px 9px; font-size: 13px; background: #fafaf8;
    outline: none; font-family: inherit; transition: border-color .15s;
  }
  .field input:focus, .field select:focus, .field textarea:focus {
    border-color: #888; background: #fff;
  }
  .field textarea { resize: vertical; min-height: 60px; line-height: 1.4; }
  .time-row { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }

  /* — color swatches — */
  .colors { display: flex; gap: 5px; flex-wrap: wrap; margin-top: 3px; }
  .cswatch {
    width: 22px; height: 22px; border-radius: 50%; cursor: pointer;
    border: 2px solid transparent; transition: transform .1s;
  }
  .cswatch:hover { transform: scale(1.15); }
  .cswatch.sel { border-color: #333; }

  /* — add button — */
  #add-btn {
    width: 100%; margin-top: .5rem; background: #dbeafe; color: #1e40af;
    border: 1px solid #bfdbfe; border-radius: 8px; padding: 8px;
    font-size: 13px; font-weight: 500; cursor: pointer; transition: opacity .15s;
  }
  #add-btn:hover { opacity: .85; }

  /* — events list in panel — */
  .events-list {
    margin-top: .75rem; border-top: 1px solid #eee; padding-top: .75rem;
    display: flex; flex-direction: column; gap: 6px;
    max-height: 200px; overflow-y: auto;
  }
  .ecard { border-radius: 8px; padding: 6px 8px; position: relative; }
  .ecard-name { font-size: 12px; font-weight: 500; color: #fff; }
  .ecard-meta { font-size: 10px; color: rgba(255,255,255,.8); margin-top: 2px; }
  .ecard-del {
    position: absolute; top: 4px; right: 6px;
    background: none; border: none; color: rgba(255,255,255,.7);
    cursor: pointer; font-size: 14px; line-height: 1; padding: 0;
  }
  .ecard-del:hover { color: #fff; }
  .no-events { font-size: 12px; color: #888; text-align: center; padding: .5rem 0; }

  @media (max-width: 640px) {
    .app { grid-template-columns: 1fr; }
    .panel { position: static; }
  }
</style>

<script>
  const MONTHS = ['Enero','Febrero','Marzo','Abril','Mayo','Junio',
    'Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
  const COLORS = ['#E24B4A','#D85A30','#BA7517','#639922',
    '#1D9E75','#185FA5','#7F77DD','#D4537E','#888780'];

  interface Event {
    name: string; category: string; color: string;
    start: string; end: string; desc: string;
  }

  const today = new Date();
  let vy = today.getFullYear(), vm = today.getMonth();
  let events: Record<string, Event[]> = {};
  let selKey: string | null = null;
  let selColor = COLORS[5];

  const calEl = document.getElementById('cal')!;
  const selLabel = document.getElementById('sel-label')!;
  const evList = document.getElementById('events-list')!;

  // Color picker
  const cp = document.getElementById('color-picker')!;
  COLORS.forEach(c => {
    const s = document.createElement('div');
    s.className = 'cswatch' + (c === selColor ? ' sel' : '');
    s.style.background = c;
    s.addEventListener('click', () => {
      selColor = c;
      cp.querySelectorAll('.cswatch').forEach(x => x.classList.remove('sel'));
      s.classList.add('sel');
    });
    cp.appendChild(s);
  });

  function getKey(y: number, m: number, d: number) {
    return `${y}-${String(m).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
  }

  function render() {
    document.getElementById('mlabel')!.textContent = `${MONTHS[vm]} ${vy}`;
    calEl.innerHTML = '';
    const first = new Date(vy, vm, 1).getDay();
    const dim = new Date(vy, vm + 1, 0).getDate();

    for (let i = 0; i < first; i++) {
      const e = document.createElement('div'); e.className = 'day empty'; calEl.appendChild(e);
    }
    for (let d = 1; d <= dim; d++) {
      const div = document.createElement('div');
      div.className = 'day';
      const key = getKey(vy, vm, d);
      const isToday = d === today.getDate() && vm === today.getMonth() && vy === today.getFullYear();
      if (isToday) div.classList.add('today');
      if (selKey === key) div.classList.add('selected');

      const num = document.createElement('div');
      num.className = 'dnum'; num.textContent = String(d);
      div.appendChild(num);

      if ((events[key] ?? []).length > 0) {
  const dots = document.createElement('div');
  dots.style.cssText = 'display:flex;gap:3px;flex-wrap:wrap;margin-top:2px;';
  (events[key] ?? []).slice(0, 5).forEach(ev => {
    const dot = document.createElement('div');
    dot.style.cssText = `width:6px;height:6px;border-radius:50%;background:${ev.color};flex-shrink:0;`;
    dots.appendChild(dot);
  });
  div.appendChild(dots);
}
      div.addEventListener('click', () => selectDay(vy, vm, d));
      calEl.appendChild(div);
    }
  }

  function selectDay(y: number, m: number, d: number) {
    selKey = getKey(y, m, d);
    selLabel.textContent = `${d} de ${MONTHS[m]} ${y}`;
    render(); renderEventsList();
  }

  function renderEventsList() {
    evList.innerHTML = '';
    const evs = events[selKey!] ?? [];
    if (!evs.length) { evList.innerHTML = '<div class="no-events">Sin eventos este día</div>'; return; }
    evs.forEach((ev, i) => {
      const c = document.createElement('div');
      c.className = 'ecard'; c.style.background = ev.color;
      const time = ev.start && ev.end ? `${ev.start} – ${ev.end}` : ev.start || '';
      c.innerHTML = `<div class="ecard-name">${ev.name}</div><div class="ecard-meta">${ev.category}${time ? ' · ' + time : ''}</div><button class="ecard-del" title="Eliminar">✕</button>`;
      c.querySelector<HTMLButtonElement>('.ecard-del')!.addEventListener('click', () => {
        events[selKey!].splice(i, 1); render(); renderEventsList();
      });
      evList.appendChild(c);
    });
  }

  document.getElementById('add-btn')!.addEventListener('click', () => {
    if (!selKey) return;
    const name = (document.getElementById('f-name') as HTMLInputElement).value.trim();
    if (!name) return;
    if (!events[selKey]) events[selKey] = [];
    events[selKey].push({
      name,
      category: (document.getElementById('f-cat') as HTMLSelectElement).value,
      color: selColor,
      start: (document.getElementById('f-start') as HTMLInputElement).value,
      end: (document.getElementById('f-end') as HTMLInputElement).value,
      desc: (document.getElementById('f-desc') as HTMLTextAreaElement).value.trim(),
    });
    (document.getElementById('f-name') as HTMLInputElement).value = '';
    (document.getElementById('f-desc') as HTMLTextAreaElement).value = '';
    (document.getElementById('f-start') as HTMLInputElement).value = '';
    (document.getElementById('f-end') as HTMLInputElement).value = '';
    render(); renderEventsList();
  });

  document.getElementById('prev')!.addEventListener('click', () => { vm--; if (vm < 0) { vm = 11; vy--; } render(); });
  document.getElementById('next')!.addEventListener('click', () => { vm++; if (vm > 11) { vm = 0; vy++; } render(); });

  render();
  evList.innerHTML = '<div class="no-events">Sin eventos este día</div>';
</script>